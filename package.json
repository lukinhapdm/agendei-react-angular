{
  "name": "agendei",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && turbo run lint typecheck test build",
    "db:types": "supabase gen types --lang typescript --schema public --remote \"$SUPABASE_DB_URL\" > packages/shared/src/database.types.ts && prettier --write packages/shared/src/database.types.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.8.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "supabase": "^3.4.0",
    "turbo": "^2.11.13",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.73.0"
  },
  "type": "module"
}
