{
  "name": "@agendei/admin",
  "scripts": {
    "gen:env": "node --env-file-if-exists=.env.local scripts/generate-env.mjs",
    "dev": "pnpm gen:env && ng serve --port 4200",
    "build": "pnpm gen:env && ng build",
    "typecheck": "pnpm gen:env && tsc -p tsconfig.app.json --noEmit",
    "test": "pnpm gen:env && ng test --watch=false",
    "lint": "eslint ."
  },
  "private": true,
  "dependencies": {
    "@agendei/shared": "workspace:*",
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@supabase/supabase-js": "^2.119.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "jsdom": "^31.0.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
